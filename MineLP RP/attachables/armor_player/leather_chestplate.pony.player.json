{
  "format_version": "1.10.0",
  "minecraft:attachable": {
    "description": {
      "identifier": "minecraft:leather_chestplate.player",
      "item": { "minecraft:leather_chestplate": "q.owner_identifier == 'minecraft:player'" },
      "materials": {
        "default": "armor_leather",
        "overlay": "armor",
        "enchanted": "armor_leather_enchanted"
      },
      "textures": {
        "default": "textures/models/armor/leather_1",
        "enchanted": "textures/misc/enchanted_actor_glint",
        "minelp_default": "textures/entity/equipment/ponified_humanoid_leggings/leather",
        "minelp.layer2": "textures/entity/equipment/ponified_humanoid/leather",
        "minelp_overlay": "textures/entity/equipment/ponified_humanoid_leggings/leather_overlay",
        "minelp_overlay.layer2": "textures/entity/equipment/ponified_humanoid/leather_overlay"
      },
      "geometry": {
        "default": "geometry.humanoid.armor.chestplate",
        "minelp_default": "geometry.minelp.pony.armor.chestplate",
        "minelp.layer2": "geometry.minelp.pony.armor.chestplate.layer2"
      },
      "scripts": {
        "parent_setup": "v.chest_layer_visible = 0.0;",
        "animate": [
          "offset"
        ]
      },
      "animations": {
        "offset": "animation.armor.chestplate.offset"
      },
      "render_controllers": [
        { "controller.render.armor.player": "c.owning_entity->v.minelp_is_pony != 1.0" },
        { "controller.render.minelp.pony.armor": "c.owning_entity->v.minelp_is_pony == 1.0" },
        { "controller.render.minelp.pony.armor.layer2": "c.owning_entity->v.minelp_is_pony == 1.0" },
        { "controller.render.minelp.pony.armor.overlay": "c.owning_entity->v.minelp_is_pony == 1.0" },
        { "controller.render.minelp.pony.armor.overlay.layer2": "c.owning_entity->v.minelp_is_pony == 1.0" }
      ]
    }
  }
}
