{
  "format_version": "1.10.0",
  "minecraft:attachable": {
    "description": {
      "identifier": "minecraft:leather_leggings",
      "materials": {
        "default": "armor_leather",
        "overlay": "armor",
        "enchanted": "armor_leather_enchanted"
      },
      "textures": {
        "default": "textures/models/armor/leather_2",
        "enchanted": "textures/misc/enchanted_actor_glint",
        "baby": "textures/models/armor/leather_baby",
        "minelp_default": "textures/entity/equipment/ponified_humanoid_leggings/leather",
        "minelp_overlay": "textures/entity/equipment/ponified_humanoid_leggings/leather_overlay"
      },
      "geometry": {
        "default": "geometry.humanoid.armor.leggings",
        "baby": "geometry.humanoid.baby.armor.leggings",
        "minelp_default": "geometry.minelp.pony.armor.leggings"
      },
      "scripts": {
        "parent_setup": "v.leg_layer_visible = 0.0;",
        "pre_animation": [
          "v.use_baby_geo = q.is_baby && c.owning_entity->v.use_dedicated_baby_armor;"
        ]
      },
      "render_controllers": [
        { "controller.render.armor.v2": "c.owning_entity->v.minelp_is_pony != 1.0" },
        { "controller.render.minelp.pony.armor": "c.owning_entity->v.minelp_is_pony == 1.0" },
        { "controller.render.minelp.pony.armor.overlay": "c.owning_entity->v.minelp_is_pony == 1.0" }
      ]
    }
  }
}
