{
  "format_version": "1.10.0",
  "minecraft:attachable": {
    "description": {
      "identifier": "minecraft:copper_chestplate",
      "materials": {
        "default": "armor",
        "enchanted": "armor_enchanted"
      },
      "textures": {
        "default": "textures/models/armor/copper_1",
        "enchanted": "textures/misc/enchanted_actor_glint",
        "baby": "textures/models/armor/copper_baby",
        "minelp_default": "textures/entity/equipment/ponified_humanoid_leggings/copper",
        "minelp.layer2": "textures/entity/equipment/ponified_humanoid/copper"
      },
      "geometry": {
        "default": "geometry.humanoid.armor.chestplate",
        "baby": "geometry.humanoid.baby.armor.chestplate",
        "minelp_default": "geometry.minelp.pony.armor.chestplate",
        "minelp.layer2": "geometry.minelp.pony.armor.chestplate.layer2"
      },
      "scripts": {
        "parent_setup": "v.chest_layer_visible = 0.0;",
        "pre_animation": [
          "v.use_baby_geo = q.is_baby && c.owning_entity->v.use_dedicated_baby_armor;"
        ]
      },
      "render_controllers": [
        { "controller.render.armor.v2": "c.owning_entity->v.minelp_is_pony != 1.0" },
        { "controller.render.minelp.pony.armor": "c.owning_entity->v.minelp_is_pony == 1.0" },
        { "controller.render.minelp.pony.armor.layer2": "c.owning_entity->v.minelp_is_pony == 1.0" }
      ]
    }
  }
}
